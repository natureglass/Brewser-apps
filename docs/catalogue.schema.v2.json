{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brewser.io/schema/catalogue-v2.json",
  "title": "Brewser catalogue envelope v2",
  "description": "Contract for play.brewser.io/catalogue.json. Entries are slim projections of the manifest (browse/decide fields only) — full description, allowed_origins, exitGame, fullscreen, buttonMapping live in the installed manifest.json. Serialization is pinned (UTF-8 no BOM, indent=2, ensure_ascii=False, sort_keys=True, LF, single trailing newline). Cross-field rules Draft-07 cannot express (defaultSource must be a key of sources; every entry source must be a key of sources) are enforced by the producer and the runtime normalizer. Unknown properties at envelope or entry level are non-breaking additions; breaking shape changes require a version bump.",
  "type": "object",
  "required": ["version", "generated", "sources", "defaultSource", "revoked", "apps"],
  "properties": {
    "version": { "const": 2 },
    "generated": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9]{0,15}$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^https://[^\\s/]+(/[^\\s/]+)*$"
      }
    },
    "defaultSource": { "type": "string" },
    "revoked": {
      "type": "array",
      "items": { "$ref": "#/definitions/appId" }
    },
    "apps": {
      "type": "array",
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "appId": {
      "type": "string",
      "pattern": "^com\\.[a-z0-9]{3,32}\\.[a-z0-9]{2,48}$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "entry": {
      "type": "object",
      "required": [
        "id", "name", "version", "entry", "logo",
        "categories", "compatibility", "permissions",
        "developer", "license", "sizeBytes", "summary", "publishedAt"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/appId" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "maxLength": 400 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "logo": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "categories": {
          "allOf": [{ "$ref": "#/definitions/stringArray" }],
          "minItems": 1
        },
        "permissions": { "$ref": "#/definitions/stringArray" },
        "compatibility": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["switch", "web", "smartphone", "android"] }
        },
        "developer": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "genre": { "$ref": "#/definitions/stringArray" },
        "features": { "$ref": "#/definitions/stringArray" },
        "tags": { "$ref": "#/definitions/stringArray" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "minLength": 1 },
        "featured": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
