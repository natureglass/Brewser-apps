{
  "$schema": "./midi-controllers.schema.json",
  "meta": {
    "version": "1.0.0",
    "description": "Input/output MIDI mapping database for common hardware controllers, keyed by Web MIDI port-name substrings. Values reflect each device's factory-default program/mode unless noted. Devices with reassignable maps (LPD8, MPD, nanoPAD/KONTROL) carry the manufacturer default; users can remap via the vendor editor.",
    "channel_convention": "1-based (channel 1 = MIDI status nibble 0). Subtract 1 for the raw status byte.",
    "note_convention": "Raw MIDI note numbers 0-127. Middle C (60) = C3 here.",
    "led_note": "For grid/pad devices, the same note that a pad SENDS is used to light its LED via an outbound Note On (velocity/channel encodes colour where applicable)."
  },
  "controllers": {
    "akai_lpd8": {
      "vendor": "Akai",
      "model": "LPD8 (original)",
      "match": ["LPD8"],
      "match_exclude": ["LPD8 mk2", "LPD8 MKII", "LPD8mk2"],
      "notes": "Factory Program 1. Pads default to NOTE mode; a PAD/CC toggle can switch pads to CC. 4 recallable programs; only defaults listed. Fully remappable via Akai LPD8 Editor.",
      "controls": {
        "pads": {
          "kind": "pad",
          "count": 8,
          "layout": { "rows": 2, "cols": 4, "order": "top-left-to-right" },
          "input": { "type": "note", "channel": 1, "notes": [100,101,102,103,104,105,106,107], "velocity": "0-127" },
          "output": { "type": "note_on", "channel": 1, "notes": [100,101,102,103,104,105,106,107], "purpose": "pad LED (red, on/off)" }
        },
        "knobs": {
          "kind": "knob",
          "count": 8,
          "layout": { "rows": 1, "cols": 8 },
          "input": { "type": "cc", "channel": 1, "ccs": [20,5,6,7,30,2,3,4], "range": "0-127" }
        }
      }
    },

    "akai_lpd8_mk2": {
      "vendor": "Akai",
      "model": "LPD8 mk2",
      "match": ["LPD8 mk2", "LPD8 MKII", "LPD8mk2"],
      "notes": "Factory Program 1. RGB pads. Pads and knobs fully remappable via LPD8 mk2 Editor. Default program 1 sends the values below; MPC-oriented programs use pad notes 36-43 / knob CC 44-51.",
      "controls": {
        "pads": {
          "kind": "pad",
          "count": 8,
          "layout": { "rows": 2, "cols": 4, "order": "top-left-to-right" },
          "input": { "type": "note", "channel": 1, "notes": [60, 62, 64, 65, 67, 69, 71, 72], "velocity": "0-127" },
          "output": { "type": "note_on", "channel": 1, "notes": [60, 62, 64, 65, 67, 69, 71, 72], "purpose": "pad RGB LED" }
        },
        "knobs": {
          "kind": "knob",
          "count": 8,
          "layout": { "rows": 1, "cols": 8 },
          "input": { "type": "cc", "channel": 1, "ccs": [70, 71, 72, 73, 74, 75, 76, 77], "range": "0-127" }
        }
      }
    },

    "akai_lpk25": {
      "vendor": "Akai",
      "model": "LPK25 / LPK25 mk2",
      "match": ["LPK25", "LPK 25"],
      "notes": "25-key mini keyboard. Keys send notes on channel 1 starting at C1 (36) by default, shiftable by octave via OCT buttons. Has a tap-tempo/arp but no CC controls by default.",
      "controls": {
        "keys": {
          "kind": "key",
          "count": 25,
          "input": { "type": "note", "channel": 1, "note_start": 48, "note_end": 72, "velocity": "0-127" }
        }
      }
    },

    "akai_apc_mini": {
      "vendor": "Akai",
      "model": "APC mini (mk1)",
      "match": ["APC MINI"],
      "match_exclude": ["APC mini mk2", "APC MINI MK2"],
      "notes": "8x8 clip grid + 8 track buttons + 8 scene buttons + shift + 9 faders. Grid note 0 is bottom-left, ascending left-to-right then up. LED colour set by outbound Note On velocity (0 off, 1 green, 3 red, 5 amber; +blink variants).",
      "controls": {
        "grid": {
          "kind": "pad",
          "count": 64,
          "layout": { "rows": 8, "cols": 8, "origin": "bottom-left", "order": "row-major-upward" },
          "input": { "type": "note", "channel": 1, "note_start": 0, "note_end": 63, "velocity": "0-127" },
          "output": { "type": "note_on", "channel": 1, "note_start": 0, "note_end": 63, "purpose": "pad LED colour via velocity" }
        },
        "track_buttons": {
          "kind": "button",
          "count": 8,
          "input": { "type": "note", "channel": 1, "notes": [64, 65, 66, 67, 68, 69, 70, 71] },
          "output": { "type": "note_on", "channel": 1, "notes": [64, 65, 66, 67, 68, 69, 70, 71], "purpose": "single-colour LED" }
        },
        "scene_buttons": {
          "kind": "button",
          "count": 8,
          "input": { "type": "note", "channel": 1, "notes": [82, 83, 84, 85, 86, 87, 88, 89] },
          "output": { "type": "note_on", "channel": 1, "notes": [82, 83, 84, 85, 86, 87, 88, 89], "purpose": "single-colour LED" }
        },
        "shift": {
          "kind": "button",
          "count": 1,
          "input": { "type": "note", "channel": 1, "notes": [98] }
        },
        "faders": {
          "kind": "fader",
          "count": 9,
          "layout": { "rows": 1, "cols": 9, "note": "faders 1-8 per track, 9 = master" },
          "input": { "type": "cc", "channel": 1, "ccs": [48, 49, 50, 51, 52, 53, 54, 55, 56], "range": "0-127" }
        }
      }
    },

    "akai_apc_mini_mk2": {
      "vendor": "Akai",
      "model": "APC mini mk2",
      "match": ["APC mini mk2", "APC MINI MK2"],
      "notes": "8x8 RGB grid (notes 0-63, bottom-left origin), 8 track buttons (100-107), 8 scene launch (112-119), shift (122), 9 faders (CC 48-56). RGB LEDs are set with 3-byte Note On on Port 0 where the channel selects behaviour (solid/blink/pulse) and velocity indexes a 128-colour palette.",
      "controls": {
        "grid": {
          "kind": "pad",
          "count": 64,
          "layout": { "rows": 8, "cols": 8, "origin": "bottom-left", "order": "row-major-upward" },
          "input": { "type": "note", "channel": 1, "note_start": 0, "note_end": 63, "velocity": "0-127" },
          "output": { "type": "note_on", "channel_range": [1, 16], "note_start": 0, "note_end": 63, "purpose": "RGB LED: channel=behaviour, velocity=palette index" }
        },
        "track_buttons": {
          "kind": "button",
          "count": 8,
          "input": { "type": "note", "channel": 1, "notes": [100, 101, 102, 103, 104, 105, 106, 107] },
          "output": { "type": "note_on", "channel": 1, "notes": [100, 101, 102, 103, 104, 105, 106, 107], "purpose": "single-colour LED" }
        },
        "scene_buttons": {
          "kind": "button",
          "count": 8,
          "input": { "type": "note", "channel": 1, "notes": [112, 113, 114, 115, 116, 117, 118, 119] },
          "output": { "type": "note_on", "channel": 1, "notes": [112, 113, 114, 115, 116, 117, 118, 119], "purpose": "single-colour LED" }
        },
        "shift": {
          "kind": "button",
          "count": 1,
          "input": { "type": "note", "channel": 1, "notes": [122] }
        },
        "faders": {
          "kind": "fader",
          "count": 9,
          "layout": { "rows": 1, "cols": 9, "note": "faders 1-8 per track, 9 = master" },
          "input": { "type": "cc", "channel": 1, "ccs": [48, 49, 50, 51, 52, 53, 54, 55, 56], "range": "0-127" }
        }
      }
    },

    "akai_apc40_mk2": {
      "vendor": "Akai",
      "model": "APC40 mk2",
      "match": ["APC40 mkII", "APC40 mk2", "Akai APC40"],
      "notes": "8x5 RGB clip grid across channels 1-8 (one channel per track column, notes 0-4 per column bottom-up), plus scene launch, track controls, 8 device knobs and 9 faders. Grid LEDs are RGB via velocity palette.",
      "controls": {
        "grid": {
          "kind": "pad",
          "count": 40,
          "layout": { "rows": 5, "cols": 8, "origin": "bottom-left", "note": "column = MIDI channel 1-8; row = note 0 (bottom) to 4 (top)" },
          "input": { "type": "note", "channel_range": [1, 8], "note_start": 0, "note_end": 4, "velocity": "0-127" },
          "output": { "type": "note_on", "channel_range": [1, 8], "note_start": 0, "note_end": 4, "purpose": "RGB LED via velocity palette" }
        },
        "track_faders": {
          "kind": "fader",
          "count": 8,
          "input": { "type": "cc", "channel_range": [1, 8], "cc": 7, "range": "0-127", "note": "volume, one per track channel" }
        },
        "master_fader": {
          "kind": "fader",
          "count": 1,
          "input": { "type": "cc", "channel": 1, "cc": 14, "range": "0-127" }
        },
        "device_knobs": {
          "kind": "knob",
          "count": 8,
          "input": { "type": "cc", "channel": 1, "ccs": [16, 17, 18, 19, 20, 21, 22, 23], "range": "0-127" }
        }
      }
    },

    "akai_mpd218": {
      "vendor": "Akai",
      "model": "MPD218",
      "match": ["MPD218"],
      "notes": "16 pads over 3 banks (A/B/C) + 6 knobs over 3 banks. Bank A pads default to notes 36-51 on channel 10; knobs bank A default CC 3,9,12-14,15... but are fully user-assignable in the MPD218 Editor. Defaults below are bank A.",
      "controls": {
        "pads": {
          "kind": "pad",
          "count": 16,
          "layout": { "rows": 4, "cols": 4, "origin": "bottom-left" },
          "input": { "type": "note", "channel": 10, "note_start": 36, "note_end": 51, "velocity": "0-127" }
        },
        "knobs": {
          "kind": "knob",
          "count": 6,
          "input": { "type": "cc", "channel": 1, "ccs": [3, 9, 12, 13, 14, 15], "range": "0-127" }
        }
      }
    },

    "akai_mpk_mini_mk3": {
      "vendor": "Akai",
      "model": "MPK mini mk3",
      "match": ["MPK mini 3", "MPK Mini Mk3", "MPKmini3", "MPK Mini MK III"],
      "notes": "25 mini keys, 8 pads x2 banks, 8 knobs, 4-way joystick, arp. Defaults: keys ch1; pads bank A notes 36-43 on ch10 (note mode) or CC in prog-change/CC mode; knobs default CC 70-77. All reassignable in MPK mini Editor / MPC.",
      "controls": {
        "keys": {
          "kind": "key",
          "count": 25,
          "input": { "type": "note", "channel": 1, "note_start": 48, "note_end": 72, "velocity": "0-127" }
        },
        "pads": {
          "kind": "pad",
          "count": 8,
          "layout": { "rows": 2, "cols": 4, "origin": "bottom-left" },
          "input": { "type": "note", "channel": 10, "notes": [36, 37, 38, 39, 40, 41, 42, 43], "velocity": "0-127" },
          "output": { "type": "note_on", "channel": 10, "notes": [36, 37, 38, 39, 40, 41, 42, 43], "purpose": "RGB pad LED" }
        },
        "knobs": {
          "kind": "knob",
          "count": 8,
          "input": { "type": "cc", "channel": 1, "ccs": [70, 71, 72, 73, 74, 75, 76, 77], "range": "0-127" }
        }
      }
    },

    "novation_launchkey_mini_mk3": {
      "vendor": "Novation",
      "model": "Launchkey Mini MK3",
      "match": ["Launchkey Mini MK3", "Launchkey Mini"],
      "ports": { "standalone": "MIDI 1 / DAW port 1", "daw": "DAW port 2 (channel 16 control)" },
      "notes": "25 mini keys, 16 RGB pads (2 rows x8), 8 knobs, pitch/mod touch strips. Enter DAW mode by sending Note On ch16 note 12 vel127 (exit with vel 0). Session pads send notes on ch1; Drum mode pads send on ch10; knobs send CC on ch16. Values from reverse-engineered implementation.",
      "controls": {
        "keys": {
          "kind": "key",
          "count": 25,
          "input": { "type": "note", "channel": 1, "note_start": 48, "note_end": 72, "velocity": "0-127" }
        },
        "pads_session": {
          "kind": "pad",
          "count": 16,
          "mode": "session",
          "layout": { "rows": 2, "cols": 8, "origin": "top-left" },
          "input": { "type": "note", "channel": 1, "notes": [96, 97, 98, 99, 100, 101, 102, 103, 112, 113, 114, 115, 116, 117, 118, 119], "velocity": "0-127" },
          "output": { "type": "note_on", "channel": 1, "notes": [96, 97, 98, 99, 100, 101, 102, 103, 112, 113, 114, 115, 116, 117, 118, 119], "purpose": "RGB LED velocity=colour" }
        },
        "pads_drum": {
          "kind": "pad",
          "count": 16,
          "mode": "drum",
          "layout": { "rows": 2, "cols": 8, "origin": "top-left" },
          "input": { "type": "note", "channel": 10, "note_start": 36, "note_end": 51, "velocity": "0-127" }
        },
        "knobs": {
          "kind": "knob",
          "count": 8,
          "input": { "type": "cc", "channel": 16, "ccs": [21, 22, 23, 24, 25, 26, 27, 28], "range": "0-127" }
        }
      }
    },

    "novation_launchkey_mk3": {
      "vendor": "Novation",
      "model": "Launchkey 25/37/49/61 MK3",
      "match": ["Launchkey MK3", "Launchkey 25 MK3", "Launchkey 37 MK3", "Launchkey 49 MK3", "Launchkey 61 MK3"],
      "ports": { "standalone": "MIDI port 1", "daw": "DAW port 2" },
      "notes": "Full-size keys, 16 RGB pads, 8 knobs, and (on 49/61) 9 faders. DAW-mode entry as with Mini MK3 (ch16 note12). Pads session ch1 / drum ch10; knobs CC 21-28 on ch16; faders CC 5-13 on ch16 (49/61 only).",
      "controls": {
        "keys": {
          "kind": "key",
          "count": 25,
          "input": { "type": "note", "channel": 1, "note_start": 48, "note_end": 72, "velocity": "0-127", "note": "range depends on key count / octave shift" }
        },
        "pads_session": {
          "kind": "pad",
          "count": 16,
          "mode": "session",
          "layout": { "rows": 2, "cols": 8, "origin": "top-left" },
          "input": { "type": "note", "channel": 1, "notes": [96, 97, 98, 99, 100, 101, 102, 103, 112, 113, 114, 115, 116, 117, 118, 119], "velocity": "0-127" },
          "output": { "type": "note_on", "channel": 1, "notes": [96, 97, 98, 99, 100, 101, 102, 103, 112, 113, 114, 115, 116, 117, 118, 119], "purpose": "RGB LED" }
        },
        "pads_drum": {
          "kind": "pad",
          "count": 16,
          "mode": "drum",
          "layout": { "rows": 2, "cols": 8, "origin": "top-left" },
          "input": { "type": "note", "channel": 10, "note_start": 36, "note_end": 51, "velocity": "0-127" }
        },
        "knobs": {
          "kind": "knob",
          "count": 8,
          "input": { "type": "cc", "channel": 16, "ccs": [21, 22, 23, 24, 25, 26, 27, 28], "range": "0-127" }
        },
        "faders": {
          "kind": "fader",
          "count": 9,
          "optional": true,
          "note": "49/61-key models only",
          "input": { "type": "cc", "channel": 16, "ccs": [5, 6, 7, 8, 9, 10, 11, 12, 13], "range": "0-127" }
        }
      }
    },

    "novation_launchpad_mini_mk3": {
      "vendor": "Novation",
      "model": "Launchpad Mini MK3",
      "match": ["Launchpad Mini MK3", "LPMiniMK3"],
      "ports": { "midi": "MIDI (LPMiniMK3 MIDI)", "daw": "DAW (LPMiniMK3 DAW)" },
      "notes": "8x8 RGB grid + 8 top function buttons + 8 right scene buttons, addressed in a 9x9 note layout: note = row*10 + col, bottom-left pad = 11, top-right function = 91. Programmer mode (SysEx) exposes this layout directly. Top row (91-98) and right column (19-89) are the function/scene buttons.",
      "controls": {
        "grid": {
          "kind": "pad",
          "count": 64,
          "layout": { "rows": 8, "cols": 8, "origin": "bottom-left", "note_formula": "row*10 + col (row 1-8, col 1-8) => pads 11..88" },
          "input": { "type": "note", "channel": 1, "note_start": 11, "note_end": 88, "velocity": "0-127", "sparse": true },
          "output": { "type": "note_on", "channel": 1, "note_start": 11, "note_end": 88, "purpose": "RGB via velocity palette (0-127) or SysEx RGB", "sparse": true }
        },
        "top_buttons": {
          "kind": "button",
          "count": 8,
          "input": { "type": "cc", "channel": 1, "ccs": [91, 92, 93, 94, 95, 96, 97, 98] },
          "output": { "type": "cc", "channel": 1, "ccs": [91, 92, 93, 94, 95, 96, 97, 98], "purpose": "LED colour" }
        },
        "scene_buttons": {
          "kind": "button",
          "count": 8,
          "input": { "type": "cc", "channel": 1, "ccs": [89, 79, 69, 59, 49, 39, 29, 19] },
          "output": { "type": "cc", "channel": 1, "ccs": [89, 79, 69, 59, 49, 39, 29, 19], "purpose": "LED colour" }
        }
      }
    },

    "novation_launchpad_x": {
      "vendor": "Novation",
      "model": "Launchpad X",
      "match": ["Launchpad X", "LPX"],
      "ports": { "midi": "LPX MIDI", "daw": "LPX DAW" },
      "notes": "8x8 velocity- and pressure-sensitive RGB grid with the same row*10+col note layout as the Mini MK3 (pads 11-88). Top row CC 91-98, right scene column notes 19-89. Supports note/drum layouts and full SysEx RGB in programmer mode.",
      "controls": {
        "grid": {
          "kind": "pad",
          "count": 64,
          "layout": { "rows": 8, "cols": 8, "origin": "bottom-left", "note_formula": "row*10 + col => pads 11..88" },
          "input": { "type": "note", "channel": 1, "note_start": 11, "note_end": 88, "velocity": "0-127", "sparse": true },
          "output": { "type": "note_on", "channel": 1, "note_start": 11, "note_end": 88, "purpose": "RGB via velocity or SysEx", "sparse": true }
        },
        "top_buttons": {
          "kind": "button",
          "count": 8,
          "input": { "type": "cc", "channel": 1, "ccs": [91, 92, 93, 94, 95, 96, 97, 98] },
          "output": { "type": "cc", "channel": 1, "ccs": [91, 92, 93, 94, 95, 96, 97, 98], "purpose": "LED colour" }
        },
        "scene_buttons": {
          "kind": "button",
          "count": 8,
          "input": { "type": "note", "channel": 1, "notes": [89, 79, 69, 59, 49, 39, 29, 19] },
          "output": { "type": "note_on", "channel": 1, "notes": [89, 79, 69, 59, 49, 39, 29, 19], "purpose": "LED colour" }
        }
      }
    },

