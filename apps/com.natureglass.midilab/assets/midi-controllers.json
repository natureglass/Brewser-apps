    "arturia_minilab_mk2": {
      "vendor": "Arturia",
      "model": "MiniLab mk2",
      "match": ["Arturia MiniLab mkII", "MiniLab mkII", "Minilab"],
      "notes": "25 slim keys, 16 pads (2 banks x8), 16 encoders (2 shift banks). Analog Lab factory map. Pads default notes 36-43 (bank1) on ch10; encoders CC 74,71,76,77,93,18,19,16 (bank1). Values are the Arturia factory template; remappable in MIDI Control Center.",
      "controls": {
